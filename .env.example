# ── Corpus environment ────────────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. The backend is the ONLY component
# that reads the Shelby/operator secrets; they must never reach the browser.

# ── Network ───────────────────────────────────────────────────────────────────
# One of: shelbynet | testnet | local. Default: shelbynet.
CORPUS_NETWORK=shelbynet

# ── On-chain contract ─────────────────────────────────────────────────────────
# Address the Move package is published under (the account from `aptos init`).
# Set by scripts/deploy_move.ts output, or paste your deployer address here.
CORPUS_MODULE_ADDRESS=

# ── Backend / operator secrets (server-side ONLY) ─────────────────────────────
# Ed25519 private key for the Shelby account that uploads + serves blobs.
# Accepts AIP-80 ("ed25519-priv-0x..") or raw 0x hex. Fund it via the seed script.
SHELBY_PRIVATE_KEY=
# Optional Shelby API key (format "AG-..."). Leave blank unless your shelbynet
# RPC requires one for reads; it is passed through when present.
SHELBY_API_KEY=

# ── API server ────────────────────────────────────────────────────────────────
PORT=8787
# Comma-separated allowed origins for CORS (the web app dev server).
CORS_ORIGINS=http://localhost:5173

# ── Frontend (apps/web, Vite — only VITE_* are exposed to the browser) ─────────
# These are PUBLIC by design. Never put a private key or API key in a VITE_ var.
VITE_API_BASE=http://localhost:8787
VITE_CORPUS_MODULE_ADDRESS=
VITE_CORPUS_NETWORK=shelbynet
